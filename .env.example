# SolCafe Manager Environment Configuration Template

# Client-Side Firebase Configuration (Shared with Flutter solcafe-e700b project)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=solcafe-e700b.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=solcafe-e700b
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=solcafe-e700b.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id_here

# Server-Side Firebase Admin SDK (Keep secret, never prefix with NEXT_PUBLIC_)
FIREBASE_ADMIN_PROJECT_ID=solcafe-e700b
FIREBASE_ADMIN_CLIENT_EMAIL=your_admin_client_email_here
FIREBASE_ADMIN_PRIVATE_KEY=your_admin_private_key_here

# Cloudinary Integration (Keep API Secret server-side)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
NEXT_PUBLIC_CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here
